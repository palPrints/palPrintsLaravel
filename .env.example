APP_NAME=PalPrint
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=palprintdatabase
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

ADMIN_NAME="PalPrints Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Social login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# WhatsApp Cloud API (docs/whatsapp-integration-plan.md). Off by default; the dashboard works without it.
WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DEFAULT_COUNTRY_CODE=970
WHATSAPP_NEW_ORDER_TEMPLATE=new_print_order
WHATSAPP_NEW_ORDER_TEMPLATE_LANG=ar
WHATSAPP_PRINT_FILE_TEMPLATE=
WHATSAPP_PRINT_FILE_TEMPLATE_LANG=ar
WHATSAPP_NOTIFICATION_TEMPLATE=palprints_notification
WHATSAPP_NOTIFICATION_TEMPLATE_LANG=ar

# Telegram bot for print shops' new orders. Create the bot with @BotFather. Locally run `php artisan telegram:poll`
# (and `php artisan queue:work`); in production set the webhook with `php artisan telegram:webhook`.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Demo (mock) data on deploy: with true, `php artisan migrate` seeds it once when there are fewer approved print
# shops than DEMO_MIN_SHOPS. Left out, it is on with APP_ENV=production and off otherwise.
# Remove the demo shops and orders with `php artisan demo:shops-clean`.
DEMO_SEED_ON_DEPLOY=false
DEMO_MIN_SHOPS=5
DEMO_PASSWORD=password
